# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/research_assistant_dev
AUTO_RUN_MIGRATIONS=true  # Auto-run migrations on startup (development only)

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_EXPIRES_IN=7d
# Get from Google Cloud Console OAuth 2.0 credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback

# API
PORT=3001
FRONTEND_URL=http://localhost:3000

# Anthropic AI
ANTHROPIC_API_KEY=your-anthropic-api-key

# File Storage
# Base path for uploaded PDF files
# Default: ./uploads (relative to project root)
# Production: /app/uploads (inside Docker container)
UPLOAD_BASE_PATH=./uploads
# MAX_FILE_SIZE=52428800  # 50MB in bytes (TODO: Implement in Story 2.3 upload endpoint)

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
